# Cloudflare Pages _redirects
# Force /v2/* paths to serve the v2/ directory literally, overriding
# any SPA-mode catch-all that rewrites unknown paths to /index.html.
# The /:splat token preserves the rest of the path.

/v2/lib/*       /v2/lib/:splat       200
/v2/surfaces/*  /v2/surfaces/:splat  200
/v2/style.css   /v2/style.css        200
/v2/            /v2/index.html       200
/v2             /v2/index.html       301
